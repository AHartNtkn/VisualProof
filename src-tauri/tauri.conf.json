{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orchard",
  "version": "0.1.0",
  "identifier": "com.visualproofassistant.orchard",
  "build": {
    "beforeDevCommand": "npm run game",
    "beforeBuildCommand": "npm run build:game",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../game/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orchard",
        "width": 1280,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
