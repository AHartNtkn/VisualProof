{
  "name": "visual-proof-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "test:physics": "vitest run --config vitest.physics.config.ts && vitest run --config vitest.physics-timing.config.ts",
    "test:all": "vitest run --config vitest.all.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "formal:size": "node scripts/check-source-size.mjs",
    "typecheck": "tsc --noEmit",
    "demo": "vite demo",
    "game": "vite game --host 127.0.0.1 --port 1420 --strictPort",
    "build:game": "vite build game --outDir dist",
    "build:game:web:e2e": "VITE_WDIO=true vite build game --outDir dist",
    "build:game:e2e": "tauri build --debug --no-bundle --features wdio-tests --config src-tauri/tauri.e2e.conf.json",
    "e2e:game": "./scripts/check-game-desktop.sh e2e",
    "stress:game": "./scripts/check-game-desktop.sh stress",
    "tauri": "tauri",
    "dev:game": "tauri dev",
    "build:game:desktop": "tauri build",
    "emit:game-saves": "tsx scripts/emit-game-saves.ts",
    "emit:theories": "tsx scripts/emit-theories.ts",
    "preapp": "npm run emit:theories",
    "app": "vite app",
    "pree2e": "npm run emit:theories",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22",
    "@types/three": "^0.170.0",
    "@wdio/cli": "^9.31.3",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.3",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "tsx": "^4.22.5",
    "typescript": "^5.5.0",
    "vite": "^5",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "three": "^0.170.0"
  }
}
