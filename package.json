{
  "name": "visual-proof-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "test:physics": "vitest run --config vitest.physics.config.ts && vitest run --config vitest.physics-timing.config.ts",
    "test:all": "vitest run --config vitest.all.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "formal:size": "node scripts/check-source-size.mjs",
    "typecheck": "tsc --noEmit",
    "demo": "vite demo",
    "game": "vite game --host 127.0.0.1 --port 1420 --strictPort",
    "build:game": "vite build game --outDir dist",
    "tauri": "tauri",
    "dev:game": "tauri dev",
    "build:game:desktop": "tauri build",
    "emit:game-saves": "tsx scripts/emit-game-saves.ts",
    "orchard": "vite orchard",
    "emit:orchard-world": "tsx scripts/emit-orchard-world.ts",
    "prebuild:orchard": "npm run emit:orchard-world",
    "build:orchard": "vite build orchard --outDir dist",
    "e2e:orchard": "playwright test --config orchard/playwright.config.ts",
    "stress:orchard": "ORCHARD_STRESS=1 playwright test --config orchard/playwright.config.ts orchard-stress.spec.ts",
    "stress:orchard:raw": "ORCHARD_STRESS=1 ORCHARD_STRESS_MODE=raw ORCHARD_STRESS_COUNTS=10,50,100 playwright test --config orchard/playwright.config.ts orchard-stress.spec.ts",
    "emit:theories": "tsx scripts/emit-theories.ts",
    "preapp": "npm run emit:theories",
    "app": "vite app",
    "pree2e": "npm run emit:theories",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20",
    "@types/three": "^0.170.0",
    "tsx": "^4.22.5",
    "typescript": "^5.5.0",
    "vite": "^5",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "three": "^0.170.0"
  }
}
